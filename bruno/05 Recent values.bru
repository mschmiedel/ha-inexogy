meta {
  name: 05 Recent values
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/measurement-series/{{seriesId}}/recent?from={{from}}&dimension=standard
  body: none
  auth: bearer
}

params:query {
  from: {{from}}
  dimension: standard
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // 3 hours, like the integration on its first poll. Later polls count from the
  // newest point of the previous response (SPEC REQ-10).
  bru.setVar("from", Date.now() - 3 * 60 * 60 * 1000);
}

docs {
  Used by the integration on every poll (`async_get_recent`). Run "03 User settings"
  first to fill `seriesId`.

  One entry per meter and series: `type` ENERGY (current meter reading) or POWER
  (15-minute intervals), `seriesType` CONSUMPTION or FEED. ENERGY ignores `from` and
  always holds the newest reading; POWER is limited to the window and is left out
  when the window holds no interval, e.g. if inexogy delivers more than 3 hours late.
  Value lists are
  delta-encoded (first entry absolute, then differences) for `time`, `value` and
  `reading`. Energy in 10^-10 kWh, power in mW, feed-in power negative.
}
