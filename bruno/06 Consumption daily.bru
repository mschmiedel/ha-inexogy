meta {
  name: 06 Consumption daily
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/measurement-series/{{seriesId}}/consumption?from={{from}}&to={{to}}&frequency=daily&dimension=standard&includeMarketPrices=false
  body: none
  auth: bearer
}

params:query {
  from: {{from}}
  to: {{to}}
  frequency: daily
  dimension: standard
  includeMarketPrices: false
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Last 7 days.
  const now = Date.now();
  bru.setVar("from", now - 7 * 24 * 60 * 60 * 1000);
  bru.setVar("to", now);
}

docs {
  Not used yet (candidate for importing external statistics). Same delta encoding
  and units as "05 Recent values"; one value per day (DST days have 23 or 25 hours).
}
